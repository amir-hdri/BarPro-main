# ─── BarPro Environment Configuration Template ─────────────────────────────────

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate keys with: openssl rand -hex 32
API_KEY="your_secure_api_key_here"
JWT_SECRET="your_jwt_signing_secret_here"
# Generate Fernet key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRIVER_ENCRYPTION_KEY="your_fernet_driver_encryption_key_here"

# ─── Master Admin credentials ────────────────────────────────────────────────
MASTER_ADMIN_USERNAME="admin"
MASTER_ADMIN_PASSWORD="your_master_admin_password_here"

# ─── Database & Cache (Production Docker names used by default) ───────────────
POSTGRES_DB="utcms_rpa"
POSTGRES_PASSWORD="your_secure_postgres_password_here"
DATABASE_URL="postgresql+asyncpg://postgres:your_secure_postgres_password_here@postgres:5432/utcms_rpa"

REDIS_PASSWORD="your_secure_redis_password_here"
REDIS_URL="redis://:your_secure_redis_password_here@redis:6379/0"

# ─── URLs & Routing ──────────────────────────────────────────────────────────
# URL of Next.js frontend (Node 1 IP or domain)
FRONTEND_URL="http://localhost:3000"
# API URL accessed by client browsers (Node 1 IP/domain on port 8000)
NEXT_PUBLIC_API_URL="http://localhost:8000"
ENVIRONMENT="production"

# ─── Multi-IP Routing & Proxies ───────────────────────────────────────────────
AVAILABLE_IP_INDICES="1,2"
WORKER_1_PROXY="http://squid_1:3128"
WORKER_2_PROXY="http://squid_2:3128" # Remote Proxy Node 2
# Optional worker 3 proxy if deployed on 3-IP setup
# WORKER_3_PROXY="http://squid_3:3128"

# ─── RPA Browser & Map Settings ───────────────────────────────────────────────
HEADLESS=true
BLOCK_MAP_TILES=true

# ─── CAPTCHA Solver Configuration ──────────────────────────────────────────────
# Provider selection:
#   auto / ensemble / composite → tries CNN → Keras → Enhanced → Local in sequence (recommended)
#   cnn → PyTorch CNN math solver (login page: expressions like "2+3")
#   keras_ocr → Keras OCR (fuel inquiry page: text/numeric captchas)
#   enhanced_ocr → Tesseract + preprocessing
#   local_ocr → Simple local OCR
#   off / none / disabled → disable automatic solving
CAPTCHA_PROVIDER="auto"

# Solving mode:
#   provider_only → use CAPTCHA_PROVIDER only
#   manual_fallback → allow manual entry if auto fails
CAPTCHA_MODE="provider_only"

# 2Captcha API (optional, for external solving)
TWOCAPTCHA_API_KEY=""

# Timeout & retry settings
CAPTCHA_TIMEOUT_SECONDS=120
CAPTCHA_POLL_SECONDS=5
CAPTCHA_MAX_RETRIES=2
CAPTCHA_LOCAL_FALLBACK_ENABLED=true
CAPTCHA_MATH_MIN_CONFIDENCE=0.62
CAPTCHA_AUTO_ONLY=true
CAPTCHA_AUTO_MAX_ATTEMPTS=3
CAPTCHA_AUTO_REFRESH_ON_RETRY=true
CAPTCHA_AUTO_RETRY_DELAY_SECONDS=0.7
CAPTCHA_REFRESH_WAIT_SECONDS=0.8
CAPTCHA_SUBMIT_RETRY_DELAY_SECONDS=0.8
CAPTCHA_VALUE_MIN_LENGTH=1
CAPTCHA_VALUE_MAX_LENGTH=6

# Adaptive rate limiting
CAPTCHA_ADAPTIVE_ENABLED=true
CAPTCHA_ADAPTIVE_WINDOW=60
CAPTCHA_ADAPTIVE_MIN_SAMPLES=10
CAPTCHA_ADAPTIVE_HIGH_FAILURE_RATE=0.35
CAPTCHA_ADAPTIVE_LOW_FAILURE_RATE=0.10
CAPTCHA_ADAPTIVE_MAX_ATTEMPTS=5
CAPTCHA_ADAPTIVE_MAX_DELAY_SECONDS=2.5

# Debug
CAPTCHA_DEBUG_SAVE_IMAGES=true
CAPTCHA_DEBUG_DIR="output/captcha_debug"

# Keras OCR (fuel inquiry page)
# Path to Python 3.12 environment with tensorflow/keras installed
# Example: /opt/barpro/venv/bin/python  (server)  or  python3  (local dev)
KERAS_PYTHON_PATH="python3"
# Keras model file (fuel inquiry page captchas)
# Place the .keras file in the project root or specify full path
KERAS_MODEL_PATH="persian_captcha_ocr_model.keras"

# PyTorch CNN Math Solver (login page)
# Model file is at: app/automation/captcha/assets/captcha_cnn.pth
# No additional config needed — auto-detected if torch is installed

# ─── Monitoring & Alerts (Optional Telegram Bot Integration) ──────────────────
# TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ─── ITMBOL Integration (Fuel quota) ───────────────────────────────────────────
# ITMBOL_SERVICE_URL="https://services2.sipaad.ir/ITMBOL.asmx"
# ITMBOL_COMPANY_CODE=""
# ITMBOL_SERVICE_PASSWORD=""

# ─── Waybill Limits ──────────────────────────────────────────────────────────
WAYBILL_MAX_CONCURRENT=2
WAYBILL_MIN_GAP_SECONDS=0.8
WAYBILL_JITTER_SECONDS=0.4
WAYBILL_MAX_RETRIES=1

# ─── API Auth ────────────────────────────────────────────────────────────────
API_AUTH_MODE="api_key_or_jwt"
API_KEY_HEADER="X-API-Key"
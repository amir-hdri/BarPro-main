# ─── BarPro Environment Configuration Template ─────────────────────────────────

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate keys with: openssl rand -hex 32
API_KEY="your_secure_api_key_here"
JWT_SECRET="your_jwt_signing_secret_here"
# Generate Fernet key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRIVER_ENCRYPTION_KEY="your_fernet_driver_encryption_key_here"

# ─── Master Admin credentials ────────────────────────────────────────────────
MASTER_ADMIN_USERNAME="admin"
MASTER_ADMIN_PASSWORD="your_master_admin_password_here"

# ─── Database & Cache (Production Docker names used by default) ───────────────
POSTGRES_DB="utcms_rpa"
POSTGRES_PASSWORD="your_secure_postgres_password_here"
DATABASE_URL="postgresql+asyncpg://postgres:your_secure_postgres_password_here@postgres:5432/utcms_rpa"

# Bind addresses for Postgres/Redis host ports.
# Default 127.0.0.1 (local-only). For remote Worker nodes (Model B) set 0.0.0.0
# AND restrict access with UFW allowlist (scripts/setup_firewall_central.sh).
POSTGRES_BIND="127.0.0.1"
REDIS_BIND="127.0.0.1"

REDIS_PASSWORD="your_secure_redis_password_here"
REDIS_URL="redis://:your_secure_redis_password_here@redis:6379/0"

# ─── URLs & Routing ──────────────────────────────────────────────────────────
# URL of frontend as seen by the browser (server IP or domain, e.g. http://<YOUR_SERVER_IP>)
# IMPORTANT: Set this to your server's public IP or domain, NOT localhost in production
FRONTEND_URL="http://YOUR_SERVER_IP"
# API URL prefix accessed by client browsers (relative path goes through Nginx proxy)
# In Docker production: use "/api" (Nginx proxies /api → backend:8000)
# Local dev: use "http://localhost:8000"
NEXT_PUBLIC_API_URL="/api"
ENVIRONMENT="production"

# Multi-IP Routing & Proxies
# ─────────────────────────────────────────────────────────────────────────────
# Squid containers run with network_mode: host → they bind on the HOST's loopback.
# Workers run in Docker bridge network (172.20.0.x).
# Use the Docker bridge gateway 172.20.0.1 to reach the HOST from inside workers.
# DO NOT use localhost/127.0.0.1 (resolves to the container itself, not the host).
# DO NOT use host.docker.internal (unreachable from Linux Docker bridge networks).
#
# On production server: replace 172.20.0.1 with actual server IPs if Squid
# is on a separate host, e.g.:
#   WORKER_1_PROXY="http://<CENTRAL_IP>:3128"
#   WORKER_2_PROXY="http://<SECONDARY_EGRESS_IP>:3129"
#
AVAILABLE_IP_INDICES="1,2"
WORKER_1_PROXY="http://172.20.0.1:3128"
WORKER_2_PROXY="http://172.20.0.1:3129"
WORKER_3_PROXY="http://172.20.0.1:3130"

# ─── RPA Browser & Map Settings ───────────────────────────────────────────────
HEADLESS=true
BLOCK_MAP_TILES=true

# ─── CAPTCHA Solver Configuration ──────────────────────────────────────────────
# Provider selection:
#   auto / ensemble / composite → tries CNN → Keras → Enhanced → Local in sequence (recommended)
#   cnn → PyTorch CNN math solver (login page: expressions like "2+3")
#   keras_ocr → Keras OCR (fuel inquiry page: text/numeric captchas)
#   enhanced_ocr → Tesseract + preprocessing
#   local_ocr → Simple local OCR
#   off / none / disabled → disable automatic solving
CAPTCHA_PROVIDER="auto"

# Solving mode:
#   provider_only → use CAPTCHA_PROVIDER only
#   manual_fallback → allow manual entry if auto fails
CAPTCHA_MODE="provider_only"

# 2Captcha API (optional, for external solving)
TWOCAPTCHA_API_KEY=""

# Timeout & retry settings
CAPTCHA_TIMEOUT_SECONDS=120
CAPTCHA_POLL_SECONDS=5
CAPTCHA_MAX_RETRIES=2
CAPTCHA_LOCAL_FALLBACK_ENABLED=true
CAPTCHA_MATH_MIN_CONFIDENCE=0.62
CAPTCHA_AUTO_ONLY=true
CAPTCHA_AUTO_MAX_ATTEMPTS=3
CAPTCHA_AUTO_REFRESH_ON_RETRY=true
CAPTCHA_AUTO_RETRY_DELAY_SECONDS=0.7
CAPTCHA_REFRESH_WAIT_SECONDS=0.8
CAPTCHA_SUBMIT_RETRY_DELAY_SECONDS=0.8
CAPTCHA_VALUE_MIN_LENGTH=1
CAPTCHA_VALUE_MAX_LENGTH=6

# Adaptive rate limiting
CAPTCHA_ADAPTIVE_ENABLED=true
CAPTCHA_ADAPTIVE_WINDOW=60
CAPTCHA_ADAPTIVE_MIN_SAMPLES=10
CAPTCHA_ADAPTIVE_HIGH_FAILURE_RATE=0.35
CAPTCHA_ADAPTIVE_LOW_FAILURE_RATE=0.10
CAPTCHA_ADAPTIVE_MAX_ATTEMPTS=5
CAPTCHA_ADAPTIVE_MAX_DELAY_SECONDS=2.5

# Debug
CAPTCHA_DEBUG_SAVE_IMAGES=true
CAPTCHA_DEBUG_DIR="output/captcha_debug"

# Keras OCR (fuel inquiry page)
# Path to Python 3.12 environment with tensorflow/keras installed
# Example: /opt/barpro/venv/bin/python  (server)  or  python3  (local dev)
KERAS_PYTHON_PATH="python3"
# Keras model file (fuel inquiry page captchas)
# Place the .keras file in the project root or specify full path
KERAS_MODEL_PATH="persian_number_ocr.keras"

# PyTorch CNN Math Solver (login page)
# Model file is at: app/automation/captcha/assets/captcha_cnn.pth
# No additional config needed — auto-detected if torch is installed

# ─── API Auth ────────────────────────────────────────────────────────────────
API_AUTH_MODE="api_key_or_jwt"
API_KEY_HEADER="X-API-Key"

# ─── JWT Configuration ──────────────────────────────────────────────────────
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_AUDIENCE=""
JWT_ISSUER=""
JWT_LEEWAY_SECONDS=10

# ─── UTCMS Credentials ──────────────────────────────────────────────────────
UTCMS_USERNAME=""
UTCMS_PASSWORD=""
UTCMS_CAPTCHA_VALUE=""
UTCMS_ENABLE_MANUAL_CAPTCHA=false
UTCMS_MANUAL_CAPTCHA_TIMEOUT_SECONDS=120
UTCMS_MANUAL_CAPTCHA_POLL_SECONDS=0.7

# ─── URLs ───────────────────────────────────────────────────────────────────
BASE_URL="https://barname.utcms.ir"
LOGIN_URL="https://barname.utcms.ir/Barname/Account/Login"
WAYBILL_URL="https://barname.utcms.ir/barname/Document/HagigiHogugi"

# ─── Auth State Persistence ─────────────────────────────────────────────────
AUTH_STATE_PATH=".auth/utcms_state.json"
USE_PERSISTENT_AUTH_STATE=true

# ─── Live Submit ────────────────────────────────────────────────────────────
ALLOW_LIVE_SUBMIT=false

# ─── ITMBOL Integration (Fuel quota) ────────────────────────────────────────
ITMBOL_SERVICE_URL="https://services2.sipaad.ir/ITMBOL.asmx"
ITMBOL_COMPANY_CODE=""
ITMBOL_SERVICE_PASSWORD=""
ITMBOL_TIMEOUT_SECONDS=30
ITMBOL_MAX_RETRIES=2
ITMBOL_RETRY_BASE_SECONDS=0.8
ITMBOL_BASEINFO_CACHE_TTL_SECONDS=86400
ITMBOL_VALIDATE_BASEINFO=false
ITMBOL_READYZ_LIVE_CHECK=false
READYZ_BROWSER_TIMEOUT_SECONDS=8

# ─── Waybill Timing & Retry ──────────────────────────────────────────────────
WAYBILL_MAX_CONCURRENT=2
WAYBILL_MIN_GAP_SECONDS=0.8
WAYBILL_JITTER_SECONDS=0.4
WAYBILL_MAX_RETRIES=1
WAYBILL_BLOCK_BACKOFF_SECONDS=15
WAYBILL_BLOCK_BACKOFF_MAX_SECONDS=180
WAYBILL_RETRY_BASE_SECONDS=1.0
WAYBILL_RETRY_JITTER_SECONDS=0.5

# ─── Page Navigation Timing ─────────────────────────────────────────────────
PAGE_GOTO_MAX_RETRIES=2
PAGE_GOTO_RETRY_BASE_SECONDS=1.0
PAGE_GOTO_RETRY_JITTER_SECONDS=0.4
PAGE_DEFAULT_TIMEOUT=30000
PAGE_NAVIGATION_TIMEOUT=45000

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DSN=""

# ─── Queue Configuration ────────────────────────────────────────────────────
QUEUE_ENABLED=true
QUEUE_INLINE_FALLBACK=false
DEPRECATE_OLD_EXECUTION_PATH=true
QUEUE_IDEMPOTENCY_HEADER="X-Idempotency-Key"
QUEUE_READYZ_LIVE_CHECK=false

# ─── Celery Configuration ───────────────────────────────────────────────────
CELERY_BROKER_URL="redis://:your_secure_redis_password_here@redis:6379/0"
CELERY_RESULT_BACKEND="redis://:your_secure_redis_password_here@redis:6379/0"
CELERY_TASK_QUEUE="waybill_tasks"
CELERY_DLQ_QUEUE="waybill_dlq"
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_MAX_RETRIES=5
CELERY_RETRY_BASE_SECONDS=2.0
CELERY_RETRY_JITTER_SECONDS=1.5
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_DEFAULT_PRIORITY=5
CELERY_MIN_PRIORITY=0
CELERY_MAX_PRIORITY=9

# ─── Proxy Routing ──────────────────────────────────────────────────────────
RPA_PROXIES="http://172.20.0.1:3128,http://172.20.0.1:3129,http://172.20.0.1:3130"
RPA_PROXY_LIST_FILE=""

# ─── Browser Pool ───────────────────────────────────────────────────────────
BROWSER_POOL_ENABLED=false
BROWSER_POOL_SIZE=8

# ─── Circuit Breaker ────────────────────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=2

# ─── Multi-Tenant ───────────────────────────────────────────────────────────
MULTITENANT_ENABLED=true

# ─── Driver Daily Caps ─────────────────────────────────────────────────────
DRIVER_DAILY_SUCCESS_CAP=10
DRIVER_DAILY_ATTEMPT_CAP=200
DRIVER_RETRY_DELAY_SECONDS=120

# ─── RPA Session & Scheduling ──────────────────────────────────────────────
# RPA_LOCK_TTL_SECONDS removed — code default 360 applies (config.py)
RPA_SESSION_TTL_SECONDS=7200
RPA_SESSION_REFRESH_SKEW_SECONDS=300
RPA_SCHEDULER_BATCH_SIZE=200
RPA_SCHEDULER_TENANT_SLICE=20
RPA_SCHEDULER_INTERVAL_SECONDS=15
RPA_AUTH_QUEUE="rpa_auth"
RPA_SUBMIT_QUEUE="rpa_submit"
RPA_REFRESH_QUEUE="rpa_refresh"
RPA_DEADLETTER_QUEUE="rpa_deadletter"
RPA_SCHEDULER_QUEUE="rpa_scheduler"
# UTCMS submission endpoint — if empty, falls back to browser-based submission (slower)
RPA_SUBMIT_ENDPOINT="https://barname.utcms.ir/api/path/to/submit"
# Extra frontend URLs for CORS (comma-separated, e.g. http://<CENTRAL_IP>,http://<SECONDARY_EGRESS_IP>)
FRONTEND_URLS=""
# Alternate frontend URL for dual-IP CORS support
FRONTEND_URL_ALT=""
RPA_AUTH_CONCURRENCY_PER_TENANT=2
RPA_SUBMIT_CONCURRENCY_PER_TENANT=10
RPA_PROXY_COOLDOWN_SECONDS=900

# ─── Excel Upload ──────────────────────────────────────────────────────────
MAX_UPLOAD_ROWS=1000
ALLOWED_UPLOAD_EXTENSIONS="xlsx,xls,csv"

# ─── Map Bypass ────────────────────────────────────────────────────────────
MAP_BYPASS_ENABLED=true
ORIGIN_TEXT_SELECTOR="input[name='Origin'], #OriginInput"
DESTINATION_TEXT_SELECTOR="input[name='Destination'], #DestinationInput"

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LATENCY_SAMPLE_MAX=2000
FAILURE_ARTIFACTS_DIR="output/failure_artifacts"
TRACE_HEADER_NAME="X-Correlation-ID"
LOG_FILE=""
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=5
LOG_DIR="/var/log/barpro"
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_SECRET="your_alert_webhook_secret_here"

# ─── WebSocket & Heartbeat ─────────────────────────────────────────────────
WS_EVENT_HISTORY_LIMIT=500
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALL_TIMEOUT_SECONDS=45

# ─── Business Rules ─────────────────────────────────────────────────────────
BUSINESS_TIMEZONE="Asia/Tehran"

# ─── Worker Node Settings (فقط برای .env روی ورکرها — Worker 2 و 3) ────────
# این متغیرها فقط در .env روی Remote Worker Nodeها تنظیم می‌شوند.
# روی سرور مرکزی این متغیرها را خالی بگذارید.
# ──────────────────────────────────────────────────────────────────────────────
# شناسه منحصربه‌فرد ورکر (مثال: worker_2 یا worker_3)
WORKER_ID=""
# ایندکس IP ورکر — باید با AVAILABLE_IP_INDICES سرور مرکزی هم‌خوانی داشته باشد
WORKER_IP_INDEX=""
# پورت Squid محلی روی سرور ورکر (پیش‌فرض: 3128)
WORKER_PROXY_PORT="3128"
# IP سرور مرکزی (برای اتصال DB و Redis از ورکرها)
CENTRAL_IP="87.107.5.238"

# ─── Grafana Monitoring ──────────────────────────────────────────────────────
# نام کاربری و رمز Grafana Admin Panel
# Generate with: openssl rand -base64 16
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="your_grafana_admin_password_here"
GRAFANA_ROOT_URL="http://127.0.0.1:3000"

# ─── Auth Cookie ─────────────────────────────────────────────────────────────
# false در HTTP، true بعد از نصب HTTPS/Let's Encrypt
AUTH_COOKIE_SECURE="false"

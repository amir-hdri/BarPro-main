# ─── URLs & Routing ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development

# ─── Multi-IP Routing & Proxies ──────────────────────────────────────────────
AVAILABLE_IP_INDICES=1
WORKER_1_PROXY=http://localhost:3128
WORKER_2_PROXY=http://localhost:3129
WORKER_3_PROXY=http://localhost:3130

# ─── RPA Browser & Map Settings ───────────────────────────────────────────────
HEADLESS=true
BLOCK_MAP_TILES=true

# ─── CAPTCHA Solver Configuration ──────────────────────────────────────────────
CAPTCHA_PROVIDER=off
CAPTCHA_MODE=provider_only
TWOCAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_SECONDS=120
CAPTCHA_POLL_SECONDS=5
CAPTCHA_MAX_RETRIES=2
CAPTCHA_LOCAL_FALLBACK_ENABLED=false
CAPTCHA_MATH_MIN_CONFIDENCE=0.62
CAPTCHA_AUTO_ONLY=true
CAPTCHA_AUTO_MAX_ATTEMPTS=3
CAPTCHA_AUTO_REFRESH_ON_RETRY=true
CAPTCHA_AUTO_RETRY_DELAY_SECONDS=0.7
CAPTCHA_REFRESH_WAIT_SECONDS=0.8
CAPTCHA_SUBMIT_RETRY_DELAY_SECONDS=0.8
CAPTCHA_VALUE_MIN_LENGTH=1
CAPTCHA_VALUE_MAX_LENGTH=6
CAPTCHA_ADAPTIVE_ENABLED=false
CAPTCHA_ADAPTIVE_WINDOW=60
CAPTCHA_ADAPTIVE_MIN_SAMPLES=10
CAPTCHA_ADAPTIVE_HIGH_FAILURE_RATE=0.35
CAPTCHA_ADAPTIVE_LOW_FAILURE_RATE=0.10
CAPTCHA_ADAPTIVE_MAX_ATTEMPTS=5
CAPTCHA_ADAPTIVE_MAX_DELAY_SECONDS=2.5
CAPTCHA_DEBUG_SAVE_IMAGES=false
CAPTCHA_DEBUG_DIR=output/captcha_debug
KERAS_PYTHON_PATH=python3
KERAS_MODEL_PATH=persian_number_ocr.keras

# ─── API Auth ────────────────────────────────────────────────────────────────
API_AUTH_MODE=api_key_or_jwt
API_KEY_HEADER=X-API-Key

# ─── JWT Configuration ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_AUDIENCE=
JWT_ISSUER=
JWT_LEEWAY_SECONDS=10

# ─── UTCMS Credentials ──────────────────────────────────────────────────────
UTCMS_USERNAME=
UTCMS_PASSWORD=
UTCMS_CAPTCHA_VALUE=
UTCMS_ENABLE_MANUAL_CAPTCHA=false
UTCMS_MANUAL_CAPTCHA_TIMEOUT_SECONDS=120
UTCMS_MANUAL_CAPTCHA_POLL_SECONDS=0.7

# ─── URLs ───────────────────────────────────────────────────────────────────
BASE_URL=https://barname.utcms.ir
LOGIN_URL=https://barname.utcms.ir/Barname/Account/Login
WAYBILL_URL=https://barname.utcms.ir/barname/Document/HagigiHogugi

# ─── Auth State Persistence ─────────────────────────────────────────────────
AUTH_STATE_PATH=.auth/utcms_state.json
USE_PERSISTENT_AUTH_STATE=true

# ─── Live Submit ────────────────────────────────────────────────────────────
ALLOW_LIVE_SUBMIT=false

# ─── ITMBOL Integration (Fuel quota) ────────────────────────────────────────
ITMBOL_SERVICE_URL=https://services2.sipaad.ir/ITMBOL.asmx
ITMBOL_COMPANY_CODE=
ITMBOL_SERVICE_PASSWORD=
ITMBOL_TIMEOUT_SECONDS=30
ITMBOL_MAX_RETRIES=2
ITMBOL_RETRY_BASE_SECONDS=0.8
ITMBOL_BASEINFO_CACHE_TTL_SECONDS=86400
ITMBOL_VALIDATE_BASEINFO=false
ITMBOL_READYZ_LIVE_CHECK=false
READYZ_BROWSER_TIMEOUT_SECONDS=8

# ─── Waybill Timing & Retry ──────────────────────────────────────────────────
WAYBILL_MAX_CONCURRENT=2
WAYBILL_MIN_GAP_SECONDS=0.8
WAYBILL_JITTER_SECONDS=0.4
WAYBILL_MAX_RETRIES=1
WAYBILL_BLOCK_BACKOFF_SECONDS=15
WAYBILL_BLOCK_BACKOFF_MAX_SECONDS=180
WAYBILL_RETRY_BASE_SECONDS=1.0
WAYBILL_RETRY_JITTER_SECONDS=0.5

# ─── Page Navigation Timing ─────────────────────────────────────────────────
PAGE_GOTO_MAX_RETRIES=2
PAGE_GOTO_RETRY_BASE_SECONDS=1.0
PAGE_GOTO_RETRY_JITTER_SECONDS=0.4
PAGE_DEFAULT_TIMEOUT=30000
PAGE_NAVIGATION_TIMEOUT=45000

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/utcms_rpa

# ─── Queue Configuration ────────────────────────────────────────────────────
QUEUE_ENABLED=false
QUEUE_INLINE_FALLBACK=true
QUEUE_IDEMPOTENCY_HEADER=X-Idempotency-Key
QUEUE_READYZ_LIVE_CHECK=false

# ─── Celery Configuration ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:redis@localhost:6379/0
CELERY_TASK_QUEUE=waybill_tasks
CELERY_DLQ_QUEUE=waybill_dlq
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_MAX_RETRIES=5
CELERY_RETRY_BASE_SECONDS=2.0
CELERY_RETRY_JITTER_SECONDS=1.5
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_DEFAULT_PRIORITY=5
CELERY_MIN_PRIORITY=0
CELERY_MAX_PRIORITY=9

# ─── Proxy Routing ──────────────────────────────────────────────────────────
RPA_PROXIES=http://localhost:3128,http://localhost:3129,http://localhost:3130
RPA_PROXY_LIST_FILE=

# ─── Browser Pool ───────────────────────────────────────────────────────────
BROWSER_POOL_ENABLED=false
BROWSER_POOL_SIZE=2

# ─── Circuit Breaker ────────────────────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=2

# ─── Multi-Tenant ───────────────────────────────────────────────────────────
MULTITENANT_ENABLED=true

# ─── Driver Daily Caps ─────────────────────────────────────────────────────
DRIVER_DAILY_SUCCESS_CAP=10
DRIVER_DAILY_ATTEMPT_CAP=200
DRIVER_RETRY_DELAY_SECONDS=120

# ─── RPA Session & Scheduling ──────────────────────────────────────────────
RPA_LOCK_TTL_SECONDS=900
RPA_SESSION_TTL_SECONDS=7200
RPA_SESSION_REFRESH_SKEW_SECONDS=300
RPA_SCHEDULER_BATCH_SIZE=200
RPA_SCHEDULER_TENANT_SLICE=20
RPA_SCHEDULER_INTERVAL_SECONDS=15
RPA_AUTH_QUEUE=rpa_auth
RPA_SUBMIT_QUEUE=rpa_submit
RPA_REFRESH_QUEUE=rpa_refresh
RPA_DEADLETTER_QUEUE=rpa_deadletter
RPA_SCHEDULER_QUEUE=rpa_scheduler
RPA_SUBMIT_ENDPOINT=https://barname.utcms.ir/api/path/to/submit
FRONTEND_URLS=
FRONTEND_URL_ALT=
RPA_AUTH_CONCURRENCY_PER_TENANT=2
RPA_SUBMIT_CONCURRENCY_PER_TENANT=10
RPA_PROXY_COOLDOWN_SECONDS=900

# ─── Excel Upload ──────────────────────────────────────────────────────────
MAX_UPLOAD_ROWS=1000
ALLOWED_UPLOAD_EXTENSIONS=xlsx,xls,csv

# ─── Map Bypass ────────────────────────────────────────────────────────────
MAP_BYPASS_ENABLED=true
ORIGIN_TEXT_SELECTOR=input[name='Origin'], #OriginInput
DESTINATION_TEXT_SELECTOR=input[name='Destination'], #DestinationInput

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LATENCY_SAMPLE_MAX=2000
FAILURE_ARTIFACTS_DIR=output/failure_artifacts
TRACE_HEADER_NAME=X-Correlation-ID
LOG_FILE=
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=5
LOG_DIR=/var/log/barpro
ALERT_WEBHOOK_URL=

# ─── WebSocket & Heartbeat ─────────────────────────────────────────────────
WS_EVENT_HISTORY_LIMIT=500
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALL_TIMEOUT_SECONDS=45

# ─── Business Rules ─────────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Tehran


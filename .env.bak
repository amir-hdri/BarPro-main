# ─── Database & Cache (Local Development) ────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=utcms_rpa
# Use localhost for local development (Docker port mapping)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/utcms_rpa
REDIS_PASSWORD=redis

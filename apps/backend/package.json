    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "playwright": "^1.50.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

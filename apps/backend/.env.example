AUTH_RETRY_BASE_MS=3000
AUTH_RETRY_MAX_MS=300000
AUTH_RETRY_MAX_ATTEMPTS=5
AUTH_QUEUE_PAUSE_ON_CAPTCHA_FAILURE_MS=300000

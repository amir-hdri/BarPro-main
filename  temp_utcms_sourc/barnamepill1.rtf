    if (!GlobalTajmiiFlag) \{\
\
        if ($("[name='pelakIsAzad']:checked").val() == "2") \{\
            if ($("#pelakFirst").val() == "" || $("#pelakIrNum").val() == "" || $("#pelakCenter").val() == "" || $("#pelakCombo").val() == "") \{\
                $("#pelakinvalidtotal").show()\
                return false;\
            \}\
            else \{\
                $("#pelakinvalidtotal").hide()\

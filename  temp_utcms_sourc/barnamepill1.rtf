            \}\
            else \{\
                $("#pelakinvalidtotal").hide()\
                return true;\
            \}\
        \}\
    \}\
    else \{\
\
        if ($("#PelakComboTajmi").val() != "") \{\
            return true;\
        \}\
        else \{\
            return false;\
        \}\
    \}\
\
\}\

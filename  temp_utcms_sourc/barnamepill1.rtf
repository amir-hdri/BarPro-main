$(function () \{\
    // \uc0\u1605 \u1602 \u1583 \u1575 \u1585  \u1585 \u1575  \u1575 \u1740 \u1606 \u1580 \u1575  \u1578 \u1606 \u1592 \u1740 \u1605  \u1705 \u1606 : "rtl" \u1740 \u1575  "ltr"\
    const direction = "rtl";\
\
    const $boxes = $(".otp-box");\
    const $hidden = $("#otp");\
\
    // index helpers\
    const idx = el => $boxes.index(el);\
    const getBoxAt = i => $boxes.eq(i);\
    const lastIndex = () => $boxes.length - 1;\
\
    // \uc0\u1588 \u1585 \u1608 \u1593  \u1601 \u1608 \u1705 \u1608 \u1587 : \u1576 \u1585  \u1575 \u1587 \u1575 \u1587  \u1580 \u1607 \u1578 \
    if ($boxes.length) \{\
        if (direction === "rtl") \{\
            // focus \uc0\u1585 \u1608 \u1740  \u1570 \u1582 \u1585 \u1740 \u1606  \u1576 \u1575 \u1705 \u1587  (\u1587 \u1605 \u1578  \u1585 \u1575 \u1587 \u1578 \u1616  \u1576 \u1589 \u1585 \u1740 )\
            getBoxAt(lastIndex()).focus().select();\
        \} else \{\
            // ltr: \uc0\u1575 \u1608 \u1604 \u1740 \u1606  \u1576 \u1575 \u1705 \u1587 \
            getBoxAt(0).focus().select();\
        \}\
    \}\
\
    // \uc0\u1608 \u1602 \u1578 \u1740  \u1740 \u1705  \u1576 \u1575 \u1705 \u1587  \u1608 \u1585 \u1608 \u1583 \u1740  \u1605 \u1740 \u8204 \u1662 \u1584 \u1740 \u1585 \u1583 \
    $boxes.on("input", function () \{\
        const $box = $(this);\
        // \uc0\u1601 \u1602 \u1591  \u1593 \u1583 \u1583  \u1576 \u1711 \u1584 \u1575 \u1585 \
        $box.val($box.val().replace(/\\D/g, ""));\
\
        // \uc0\u1575 \u1711 \u1585  \u1740 \u1705  \u1585 \u1602 \u1605  \u1608 \u1575 \u1585 \u1583  \u1588 \u1583 \u1607 \u1548  \u1581 \u1585 \u1705 \u1578  \u1705 \u1606 \
        if ($box.val().length === 1) \{\
            const current = idx(this);\
            let nextIndex = (direction === "rtl") ? current - 1 : current + 1;\
            if (nextIndex >= 0 && nextIndex <= lastIndex()) \{\
                getBoxAt(nextIndex).focus().select();\
            \} else \{\
                // \uc0\u1575 \u1711 \u1585  \u1576 \u1607  \u1575 \u1606 \u1578 \u1607 \u1575  \u1585 \u1587 \u1740 \u1583 \u1740 \u1605 \u1548  \u1582 \u1608 \u1583  \u1585 \u1575  select \u1705 \u1606  (\u1576 \u1585 \u1575 \u1740  \u1585 \u1575 \u1581 \u1578 \u1740 )\
                $box.select();\
            \}\
        \}\
\
        updateHidden();\
    \});\
\
    // backspace: \uc0\u1608 \u1602 \u1578 \u1740  \u1582 \u1575 \u1604 \u1740 \u1587 \u1578  \u1608  backspace \u1586 \u1583 \u1607  \u1588 \u1583  \u8594  \u1581 \u1585 \u1705 \u1578  \u1576 \u1607  \u1576 \u1575 \u1705 \u1587  \u1602 \u1576 \u1604 \u1740  (\u1576 \u1585  \u1575 \u1587 \u1575 \u1587  \u1580 \u1607 \u1578 )\
    $boxes.on("keydown", function (e) \{\
        if (e.key === "Backspace") \{\
            const $this = $(this);\
            const current = idx(this);\
\
            // \uc0\u1575 \u1711 \u1585  \u1583 \u1575 \u1582 \u1604  \u1607 \u1605 \u1740 \u1606  \u1576 \u1575 \u1705 \u1587  \u1705 \u1575 \u1585 \u1575 \u1705 \u1578 \u1585 \u1740  \u1607 \u1587 \u1578 \u1548  \u1605 \u1593 \u1605 \u1608 \u1604 \u1575 \u1611  \u1581 \u1584 \u1601  \u1605 \u1740 \u1588 \u1607  \'97 \u1585 \u1601 \u1578 \u1575 \u1585  \u1593 \u1575 \u1583 \u1740 \
            // \uc0\u1575 \u1605 \u1575  \u1575 \u1711 \u1585  \u1582 \u1575 \u1604 \u1740  \u1576 \u1608 \u1583 \u1548  \u1576 \u1575 \u1740 \u1583  \u1576 \u1607  \u1576 \u1575 \u1705 \u1587  \u1602 \u1576 \u1604 \u1740  \u1581 \u1585 \u1705 \u1578  \u1705 \u1606 \u1740 \u1605 \
            if ($this.val().length === 0) \{\
                // \uc0\u1583 \u1585  RTL \u1602 \u1576 \u1604 \u1740  \u1740 \u1593 \u1606 \u1740  \u1581 \u1585 \u1705 \u1578  \u1576 \u1607  \u1585 \u1575 \u1587 \u1578 \u1548  \u1583 \u1585  LTR \u1581 \u1585 \u1705 \u1578  \u1576 \u1607  \u1670 \u1662 \
                let prevIndex = (direction === "rtl") ? current + 1 : current - 1;\
                if (prevIndex >= 0 && prevIndex <= lastIndex()) \{\
                    e.preventDefault(); // \uc0\u1580 \u1604 \u1608 \u1711 \u1740 \u1585 \u1740  \u1575 \u1586  \u1585 \u1601 \u1578 \u1575 \u1585  \u1662 \u1740 \u1588 \u8204 \u1601 \u1585 \u1590  (\u1583 \u1585  \u1589 \u1608 \u1585 \u1578  \u1606 \u1740 \u1575 \u1586 )\
                    const $prev = getBoxAt(prevIndex);\
                    $prev.focus().select();\
                    // \uc0\u1581 \u1584 \u1601  \u1705 \u1575 \u1585 \u1575 \u1705 \u1578 \u1585  \u1602 \u1576 \u1604 \u1740  \u1575 \u1711 \u1585  \u1605 \u1575 \u1740 \u1604  \u1576 \u1608 \u1583 \u1740  \u1605 \u1740 \u8204 \u1578 \u1608 \u1606 \u1740  \u1575 \u1740 \u1606 \u1580 \u1575  \u1575 \u1606 \u1580 \u1575 \u1605  \u1576 \u1583 \u1740 :\
                    // $prev.val(''); updateHidden();\
                \}\
            \}\
        \}\
    \});\
\
    // \uc0\u1575 \u1580 \u1575 \u1586 \u1607 \u8204 \u1740  paste \u1705 \u1585 \u1583 \u1606  \u1740 \u1705 \u1576 \u1575 \u1585  \u1576 \u1585 \u1575 \u1740  \u1705 \u1604  \u1705 \u1583  (\u1575 \u1711 \u1585  \u1705 \u1575 \u1585 \u1576 \u1585  paste \u1705 \u1585 \u1583 : \u1575 \u1593 \u1583 \u1575 \u1583  \u1585 \u1575  \u1576 \u1607  \u1576 \u1575 \u1705 \u1587 \u8204 \u1607 \u1575  \u1576 \u1585 \u1740 \u1586 )\
    $boxes.on("paste", function (e) \{\
        e.preventDefault();\
        const paste = (e.originalEvent || e).clipboardData.getData('text') || '';\
        const digits = paste.replace(/\\D/g, '').split('');\
        if (!digits.length) return;\
\
        if (direction === "rtl") \{\
            // \uc0\u1575 \u1586  \u1585 \u1575 \u1587 \u1578  \u1576 \u1607  \u1670 \u1662  \u1662 \u1585  \u1705 \u1606  (\u1575 \u1576 \u1578 \u1583 \u1575  \u1570 \u1582 \u1585 \u1740 \u1606  \u1576 \u1575 \u1705 \u1587 )\
            let i = lastIndex();\
            for (let d of digits) \{\
                if (i < 0) break;\
                getBoxAt(i).val(d);\
                i--;\
            \}\
        \} else \{\
            // ltr: \uc0\u1575 \u1586  \u1575 \u1576 \u1578 \u1583 \u1575  \u1662 \u1585  \u1705 \u1606 \
            let i = 0;\
            for (let d of digits) \{\
                if (i > lastIndex()) break;\
                getBoxAt(i).val(d);\
                i++;\
            \}\
        \}\
        updateHidden();\
        // \uc0\u1601 \u1608 \u1705 \u1608 \u1587  \u1585 \u1575  \u1576 \u1607  \u1575 \u1608 \u1604 \u1740 \u1606  \u1594 \u1740 \u1585 \u1662 \u1585  \u1740 \u1575  \u1570 \u1582 \u1585 \u1740 \u1606  \u1575 \u1604 \u1605 \u1606 \u1578  \u1576 \u1583 \u1607 \
        if (direction === "rtl") \{\
            const firstNotFilled = $boxes.toArray().findIndex(b => $(b).val().length === 0);\
            if (firstNotFilled === -1) getBoxAt(0).focus().select();\
            else getBoxAt(firstNotFilled).focus().select();\
        \} else \{\
            const firstNotFilled = $boxes.toArray().findIndex(b => $(b).val().length === 0);\
            if (firstNotFilled === -1) getBoxAt(lastIndex()).focus().select();\
            else getBoxAt(firstNotFilled).focus().select();\
        \}\
    \});\
\
    function updateHidden() \{\
        // \uc0\u1575 \u1711 \u1585  RTL \u1607 \u1587 \u1578 \u1740 \u1605 \u1548  \u1605 \u1593 \u1605 \u1608 \u1604 \u1575 \u1611  \u1605 \u1740 \u8204 \u1582 \u1608 \u1575 \u1607 \u1740 \u1605  \u1605 \u1602 \u1583 \u1575 \u1585  \u1606 \u1607 \u1575 \u1740 \u1740  \u1575 \u1586  \u1585 \u1575 \u1587 \u1578  \u1576 \u1607  \u1670 \u1662  \u1582 \u1608 \u1575 \u1606 \u1583 \u1607  \u1588 \u1608 \u1583 \
        // (\uc0\u1605 \u1579 \u1604 \u1575 \u1611  \u1576 \u1575 \u1705 \u1587 \u8204 \u1607 \u1575 \u1740  DOM \u1575 \u1586  \u1670 \u1662 \u8594 \u1585 \u1575 \u1587 \u1578  \u1576 \u1575 \u1588 \u1606 \u1583  \u1608 \u1604 \u1740  \u1605 \u1602 \u1583 \u1575 \u1585  OTP \u1605 \u1606 \u1591 \u1602 \u1740  \u1575 \u1586  \u1585 \u1575 \u1587 \u1578 \u8594 \u1670 \u1662 )\
        // \uc0\u1605 \u1606  \u1575 \u1740 \u1606 \u1580 \u1575  \u1576 \u1585 \u1575 \u1740  RTL \u1605 \u1602 \u1583 \u1575 \u1585  \u1585 \u1575  \u1575 \u1586  \u1585 \u1575 \u1587 \u1578  \u1576 \u1607  \u1670 \u1662  join \u1605 \u1740 \u8204 \u1705 \u1606 \u1605  (\u1583 \u1585 \u1589 \u1608 \u1585 \u1578  \u1606 \u1740 \u1575 \u1586  \u1578 \u1594 \u1740 \u1740 \u1585  \u1576 \u1583 \u1607 )\
        let code;\
        if (direction === "rtl") \{\
            // \uc0\u1578 \u1585 \u1578 \u1740 \u1576  \u1576 \u1585 \u1583 \u1575 \u1588 \u1578 : \u1575 \u1586  \u1570 \u1582 \u1585 \u1740 \u1606  \u1576 \u1607  \u1575 \u1608 \u1604 \u1740 \u1606 \
            code = $boxes.map(function () \{ return $(this).val(); \}).get().reverse().join("");\
        \} else \{\
            code = $boxes.map(function () \{ return $(this).val(); \}).get().join("");\
        \}\
        $hidden.val(code);\
    \}\
\
\});\
